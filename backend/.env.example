PORT=3000
# PostgreSQL, or MySQL 8.0.23+ with mysql://user:password@localhost:3306/schooldoc
DATABASE_URL=postgres://postgres:postgres@localhost:5432/schooldoc
# Frontend origin(s), comma-separated: CORS and the cross-site (CSRF) check use them
CORS_ORIGIN=https://localhost:5173

# --- Security ---
# Long random value (e.g. `openssl rand -base64 48`). Encrypts authenticator secrets: keep it stable and secret.
APP_SECRET=
APP_NAME=SchoolDoc
SESSION_IDLE_MINUTES=30
SESSION_MAX_HOURS=12
# false only for plain-HTTP local tests: the session cookie is otherwise sent over HTTPS only
COOKIE_SECURE=true

# --- HTTPS ---
# Either the API serves TLS itself (dev: `npm run dev-cert` creates these files)...
TLS_CERT_FILE=../certs/localhost.pem
TLS_KEY_FILE=../certs/localhost-key.pem
# ...or it runs behind an HTTPS reverse proxy (Caddy, nginx): leave TLS_* empty and set
# TRUST_PROXY=1
# HOST=127.0.0.1
# REQUIRE_HTTPS=true

# --- Email codes (SMTP). Empty in development: codes are printed in the API console ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="SchoolDoc <no-reply@your-school.cm>"

# --- SMS codes: twilio | africastalking. Empty in development: codes are printed in the API console ---
SMS_PROVIDER=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
AT_USERNAME=
AT_API_KEY=
AT_FROM=

# School time zone: "now", today and the weekday for timetables and attendance
SCHOOL_TZ=Africa/Douala
